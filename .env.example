# ── OpenRouter (free LLM) ─────────────────────────────────────────
# API key lives OUTSIDE this repo in the shared .env:
#   /home/jupyter/opencode/test/.env   (see OPENROUTER_GUIDE_FOR_AGENTS.md)
# NEVER hardcode or commit the key value.
SHARED_ENV_PATH=/home/jupyter/opencode/test/.env

# Fixed free models (do NOT use openrouter/free router - unstable)
OPENROUTER_DEFAULT_MODEL=minimax/minimax-m3:free
OPENROUTER_FALLBACK_MODELS=z-ai/glm-5.2:free,google/gemma-4-31b-it:free,nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=120
OPENROUTER_MAX_RETRIES=3

# LangSmith observability (optional)
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=true

# API server
LLM_EVALS_HOST=0.0.0.0
LLM_EVALS_PORT=8000